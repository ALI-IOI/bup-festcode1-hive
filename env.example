# Copy to .env and fill in. NEVER commit .env — it is gitignored.
# Only names are documented here; no values are committed anywhere in this repo.

# --- choose ONE provider ---
# GW_PROVIDER=anthropic   (default)   ANTHROPIC_API_KEY=...
# GW_PROVIDER=gemini                  GEMINI_API_KEY=AIza...
# GW_PROVIDER=groq                    GROQ_API_KEY=gsk_...
# GW_PROVIDER=openrouter              OPENROUTER_API_KEY=sk-or-...
# GW_PROVIDER=ollama                  (local, no key needed)

GW_PROVIDER=gemini
GEMINI_API_KEY=

# Optional. Defaults per provider: claude-sonnet-5 / gemini-3-flash /
# llama-3.3-70b-versatile. Pro models are paid-only on Gemini as of 2026.
# GW_MODEL=gemini-3-flash

PORT=8080
GW_LLM_BUDGET_MS=12000
# GW_API_URL=   # override the endpoint (proxy, self-hosted, local model)
